<button type="button" class="boton-arriba" id="boton-arriba" aria-label="Volver arriba">
	<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M12 19V5" />
		<path d="M5 12l7-7 7 7" />
	</svg>
</button>

<style>
	.boton-arriba {
		position: fixed;
		bottom: 30px;
		right: 30px;
		z-index: 200;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		border: 2px solid #22d3ee;
		background-color: rgba(5, 5, 5, 0.7);
		backdrop-filter: blur(6px);
		color: #22d3ee;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transform: translateY(10px);
		transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
	}

	.boton-arriba.visible {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	@media (hover: hover) and (pointer: fine) {
		.boton-arriba:hover {
			background-color: #22d3ee;
			color: #0f172a;
			box-shadow: 0 0 20px rgba(34, 211, 238, 0.5);
		}
	}

	.boton-arriba:active {
		transform: scale(0.92);
		background-color: #22d3ee;
		color: #0f172a;
	}

	@media (max-width: 768px) {
		.boton-arriba {
			bottom: 20px;
			right: 20px;
			width: 42px;
			height: 42px;
		}
	}
</style>

<script>
	const boton = document.getElementById("boton-arriba");

	if (boton) {
		function actualizarVisibilidad() {
			if (window.scrollY > 400) {
				boton.classList.add("visible");
			} else {
				boton.classList.remove("visible");
			}
		}

		boton.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});

		window.addEventListener("scroll", actualizarVisibilidad);
		actualizarVisibilidad();
	}
</script>
