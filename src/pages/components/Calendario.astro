---
const API_KEY = import.meta.env.GOOGLE_CALENDAR_API_KEY;
const CALENDAR_ID = import.meta.env.GOOGLE_CALENDAR_ID;

let allEvents = [];

// Paleta estándar de colores de eventos de Google Calendar (es la misma para todas las cuentas)
const COLOR_MAP = {
	"1": "#7986cb", "2": "#33b679", "3": "#8e24aa", "4": "#e67c73",
	"5": "#f6bf26", "6": "#f4511e", "7": "#039be5", "8": "#616161",
	"9": "#3f51b5", "10": "#0b8043", "11": "#d50000",
};
const COLOR_DEFAULT = "#22d3ee";

const ZONA_HORARIA = "America/Santiago";

// Dado un instante (Date), devuelve un Date "de calendario" (sin hora) que representa
// ese mismo día pero según la zona horaria de Chile — así el resultado es el mismo
// sin importar en qué huso horario esté corriendo el servidor que genera el sitio.
function obtenerDiaEnChile(instante) {
	const formatter = new Intl.DateTimeFormat("en-CA", {
		timeZone: ZONA_HORARIA,
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	});
	const [anio, mes, dia] = formatter.format(instante).split("-").map(Number);
	return new Date(anio, mes - 1, dia);
}

// Convierte la fecha de un evento de Google Calendar al día que le corresponde en Chile,
// evitando el corrimiento de día que ocurre al parsear fechas "todo el día" como UTC,
// o al calcular la hora en un servidor que corre en otro huso horario (como Netlify).
function parsearFechaEvento(item) {
	if (item.start.dateTime) {
		return obtenerDiaEnChile(new Date(item.start.dateTime));
	}
	const [anio, mes, dia] = item.start.date.split("-").map(Number);
	return new Date(anio, mes - 1, dia);
}

function formatearHoraEvento(item) {
	if (!item.start.dateTime) return "Todo el día";
	return new Date(item.start.dateTime).toLocaleTimeString("es-CL", {
		hour: "2-digit",
		minute: "2-digit",
		timeZone: ZONA_HORARIA,
	});
}

function parsearEvento(item) {
	return {
		title: item.summary || "Sin título",
		date: parsearFechaEvento(item),
		hora: formatearHoraEvento(item),
		color: COLOR_MAP[item.colorId] || COLOR_DEFAULT,
		esRecurrente: Boolean(item.recurringEventId),
	};
}

if (API_KEY && CALENDAR_ID) {
	try {
		const timeMin = new Date().toISOString();
		const url = `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(
			CALENDAR_ID
		)}/events?key=${API_KEY}&timeMin=${timeMin}&singleEvents=true&orderBy=startTime&maxResults=50`;

		const res = await fetch(url);
		const data = await res.json();

		if (data.items) {
			allEvents = data.items.map(parsearEvento);
		}
	} catch (error) {
		console.error("No se pudieron cargar los eventos del calendario:", error);
	}
}

// Para la lista de abajo: solo actividades puntuales (no recurrentes), máximo 8
const eventosEspeciales = allEvents.filter((e) => !e.esRecurrente).slice(0, 8);

const hoy = new Date();
const anioActual = hoy.getFullYear();
const mesActual = hoy.getMonth();
const diaHoy = hoy.getDate();

const NOMBRES_MES = [
	"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
	"Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
];
const DIAS_SEMANA = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];

// Genera las celdas del mes (null = celda vacía de relleno), semana empezando en lunes
function generarGrillaMes(anio, mes) {
	const primerDia = new Date(anio, mes, 1);
	const ultimoDia = new Date(anio, mes + 1, 0);
	const diasEnMes = ultimoDia.getDate();
	const offset = (primerDia.getDay() + 6) % 7; // 0 = lunes

	const celdas = [];
	for (let i = 0; i < offset; i++) celdas.push(null);
	for (let dia = 1; dia <= diasEnMes; dia++) celdas.push(dia);
	while (celdas.length % 7 !== 0) celdas.push(null);

	return celdas;
}

function eventosDelDia(dia) {
	if (!dia) return [];
	return allEvents.filter(
		(e) =>
			e.date.getFullYear() === anioActual &&
			e.date.getMonth() === mesActual &&
			e.date.getDate() === dia
	);
}

function formatearFecha(fecha) {
	return `${DIAS_SEMANA[fecha.getDay()]} ${fecha.getDate()} de ${NOMBRES_MES[fecha.getMonth()]}`;
}

const celdasMes = generarGrillaMes(anioActual, mesActual);

// Versión simplificada de los eventos para poder navegar entre meses en el navegador
const eventosSerializados = allEvents.map((e) => ({
	y: e.date.getFullYear(),
	m: e.date.getMonth(),
	d: e.date.getDate(),
	hora: e.hora,
	title: e.title,
	color: e.color,
}));
---

<section id="calendario">
	<div class="calendario-glow" aria-hidden="true"></div>

	<div class="header-calendario">
		<span class="etiqueta">Agéndate</span>
		<h2>Calendario de Actividades</h2>
	</div>

	<div class="calendario-contenedor">
		<div class="mes-card reveal">
			<div class="mes-nav">
				<button type="button" id="btn-mes-anterior" class="nav-btn" aria-label="Mes anterior">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
				</button>
				<p class="mes-titulo" id="mes-titulo-texto">{NOMBRES_MES[mesActual]} {anioActual}</p>
				<button type="button" id="btn-mes-siguiente" class="nav-btn" aria-label="Mes siguiente">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
				</button>
			</div>

			<div class="dias-semana-header">
				<span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span>
			</div>

			<div class="grid-dias" id="grid-dias">
				{celdasMes.map((dia) => {
					const eventosDia = eventosDelDia(dia);
					const tooltip = eventosDia.map((e) => `${e.hora} - ${e.title}`).join("\n");
					return (
						<div
							class:list={["celda-dia", { vacio: !dia, "con-evento": eventosDia.length > 0, "es-hoy": dia === diaHoy }]}
							title={tooltip || undefined}
						>
							<span class="numero-dia">{dia ?? ""}</span>
							{eventosDia.length > 0 && (
								<div class="chips-dia">
									{eventosDia.slice(0, 2).map((e) => (
										<div class="chip-evento" style={`background-color:${e.color}22; color:${e.color}`}>
											<span class="chip-punto" style={`background-color:${e.color}`}></span>
											<span class="chip-texto">{e.hora} · {e.title}</span>
										</div>
									))}
									{eventosDia.length > 2 && (
										<span class="mas-mini">+{eventosDia.length - 2} más</span>
									)}
								</div>
							)}
						</div>
					);
				})}
			</div>

			<div class="leyenda">
				<span class="leyenda-item"><span class="leyenda-punto punto-hoy"></span> Hoy</span>
				<span class="leyenda-item"><span class="leyenda-punto punto-actividad"></span> Actividad (pasa el mouse para ver el detalle)</span>
			</div>
		</div>

		<div class="fechas-card reveal" style="transition-delay: 0.15s;">
			<h3>Próximas Fechas Importantes</h3>

			{eventosEspeciales.length > 0 ? (
				<ul class="lista-fechas">
					{eventosEspeciales.map((evento) => (
						<li>
							<div class="timeline-marcador">
								<span class="timeline-punto" style={`background-color:${evento.color}; box-shadow: 0 0 10px ${evento.color}`}></span>
								<span class="timeline-linea"></span>
							</div>
							<div class="timeline-contenido">
								<div class="fecha-hora">
									<span class="fecha-badge" style={`color:${evento.color}`}>{formatearFecha(evento.date)}</span>
									<span class="hora-badge">{evento.hora}</span>
								</div>
								<span class="evento-titulo">{evento.title}</span>
							</div>
						</li>
					))}
				</ul>
			) : (
				<p class="sin-eventos">✨ No hay actividades especiales agendadas por el momento.</p>
			)}
		</div>
	</div>
</section>

<style>
	#calendario {
		position: relative;
		padding: 100px 20px;
		background-color: transparent;
		text-align: center;
		overflow: hidden;
	}

	.calendario-glow {
		position: absolute;
		top: 10%;
		left: 50%;
		transform: translateX(-50%);
		width: 700px;
		height: 400px;
		background: radial-gradient(circle, rgba(34, 211, 238, 0.08) 0%, transparent 70%);
		pointer-events: none;
		z-index: 0;
	}

	.header-calendario {
		position: relative;
		z-index: 2;
		margin-bottom: 60px;
	}

	.etiqueta {
		color: #22d3ee;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.85rem;
		display: block;
		margin-bottom: 10px;
		text-shadow: 0 0 10px rgba(34, 211, 238, 0.3);
	}

	h2 {
		font-size: 3rem;
		color: #ffffff;
		margin: 0;
		font-weight: 800;
		text-transform: uppercase;
	}

	.calendario-contenedor {
		position: relative;
		z-index: 2;
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.mes-card {
		position: relative;
		background-color: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.05);
		border-radius: 24px;
		padding: 35px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		overflow: hidden;
	}

	.mes-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, transparent, #22d3ee, #a855f7, transparent);
	}

	.mes-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		margin-bottom: 25px;
	}

	.mes-titulo {
		color: #ffffff;
		font-size: 1.5rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin: 0;
		min-width: 220px;
	}

	.nav-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 2px solid #22d3ee;
		background-color: transparent;
		color: #22d3ee;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-btn:hover:not(:disabled) {
			background-color: #22d3ee;
			color: #0f172a;
			box-shadow: 0 0 15px rgba(34, 211, 238, 0.5);
		}
	}

	.nav-btn:active:not(:disabled) {
		background-color: #22d3ee;
		color: #0f172a;
		transform: scale(0.9);
	}

	.nav-btn:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.dias-semana-header {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		margin-bottom: 10px;
	}

	.dias-semana-header span {
		color: #64748b;
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.grid-dias {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 6px;
	}

	.celda-dia {
		height: 72px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		gap: 3px;
		padding: 6px 3px;
		border-radius: 10px;
		color: #cbd5e1;
		font-size: 0.95rem;
		font-weight: 600;
		background-color: rgba(255,255,255,0.03);
		border: 1px solid transparent;
		transition: all 0.3s ease;
		cursor: default;
		box-sizing: border-box;
	}

	.celda-dia.vacio {
		background-color: transparent;
	}

	@media (hover: hover) and (pointer: fine) {
		.celda-dia:not(.vacio):hover {
			background-color: rgba(255,255,255,0.08);
			transform: translateY(-2px);
		}
	}

	.celda-dia.con-evento {
		background-color: rgba(255,255,255,0.05);
		border-color: rgba(255,255,255,0.15);
	}

	.celda-dia.es-hoy {
		border-color: #a855f7;
		box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.3), 0 0 14px rgba(168, 85, 247, 0.35);
	}

	.celda-dia.es-hoy .numero-dia {
		color: #d8b4fe;
		font-weight: 800;
	}

	.numero-dia {
		line-height: 1;
	}

	.chips-dia {
		display: flex;
		flex-direction: column;
		gap: 2px;
		width: 100%;
	}

	.chip-evento {
		display: flex;
		align-items: center;
		gap: 3px;
		font-size: 0.55rem;
		font-weight: 700;
		text-align: left;
		padding: 2px 5px;
		border-radius: 6px;
		min-width: 0;
	}

	.chip-texto {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.chip-punto {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.mas-mini {
		font-size: 0.55rem;
		font-weight: 700;
		color: #94a3b8;
		line-height: 1;
	}

	.leyenda {
		margin-top: 20px;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 20px;
	}

	.leyenda-item {
		display: flex;
		align-items: center;
		gap: 8px;
		color: #94a3b8;
		font-size: 0.85rem;
	}

	.leyenda-punto {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.punto-hoy {
		background-color: rgba(168, 85, 247, 0.2);
		border: 1px solid #a855f7;
		box-shadow: 0 0 8px rgba(168, 85, 247, 0.5);
	}

	.punto-actividad {
		background-color: rgba(34, 211, 238, 0.2);
		border: 1px solid #22d3ee;
		box-shadow: 0 0 8px rgba(34, 211, 238, 0.5);
	}

	.fechas-card {
		position: relative;
		background-color: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.05);
		border-radius: 24px;
		padding: 35px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		text-align: left;
		overflow: hidden;
	}

	.fechas-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, transparent, #a855f7, #22d3ee, transparent);
	}

	.fechas-card h3 {
		color: #ffffff;
		font-size: 1.4rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin: 0 0 25px 0;
		text-align: center;
	}

	.lista-fechas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}

	.lista-fechas li {
		display: flex;
		gap: 18px;
		padding-bottom: 22px;
	}

	.lista-fechas li:last-child {
		padding-bottom: 0;
	}

	.lista-fechas li:last-child .timeline-linea {
		display: none;
	}

	.timeline-marcador {
		display: flex;
		flex-direction: column;
		align-items: center;
		flex-shrink: 0;
		padding-top: 4px;
	}

	.timeline-punto {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.timeline-linea {
		width: 2px;
		flex-grow: 1;
		background: linear-gradient(to bottom, rgba(255,255,255,0.15), transparent);
		margin-top: 4px;
	}

	.timeline-contenido {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 14px 18px;
		background-color: rgba(255,255,255,0.03);
		border-radius: 12px;
		transition: background-color 0.3s ease, transform 0.3s ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.timeline-contenido:hover {
			background-color: rgba(255,255,255,0.06);
			transform: translateX(4px);
		}
	}

	.fecha-hora {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.hora-badge {
		color: #94a3b8;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.fecha-badge {
		font-weight: 800;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.evento-titulo {
		color: #e2e8f0;
		font-size: 1rem;
	}

	.sin-eventos {
		color: #94a3b8;
		text-align: center;
		font-size: 1rem;
		margin: 0;
	}

	@media (max-width: 768px) {
		#calendario { padding: 60px 10px; }
		h2 { font-size: 2.2rem; }
		.mes-card, .fechas-card { padding: 20px; }
		.celda-dia { font-size: 0.8rem; height: 66px; }
		.chip-evento { font-size: 0.48rem; }
		.mes-titulo { font-size: 1.1rem; min-width: 150px; }
		.nav-btn { width: 30px; height: 30px; }
		.timeline-contenido { padding: 12px 14px; }
	}
</style>

<script define:vars={{ eventosSerializados, anioInicial: anioActual, mesInicial: mesActual, diaHoyInicial: diaHoy, nombresMes: NOMBRES_MES }}>
	let offsetMeses = 0;

	const contenedorGrid = document.getElementById("grid-dias");
	const tituloMes = document.getElementById("mes-titulo-texto");
	const btnAnterior = document.getElementById("btn-mes-anterior");
	const btnSiguiente = document.getElementById("btn-mes-siguiente");

	function obtenerCeldasMes(anio, mes) {
		const primerDia = new Date(anio, mes, 1);
		const ultimoDia = new Date(anio, mes + 1, 0);
		const diasEnMes = ultimoDia.getDate();
		const offset = (primerDia.getDay() + 6) % 7;

		const celdas = [];
		for (let i = 0; i < offset; i++) celdas.push(null);
		for (let dia = 1; dia <= diasEnMes; dia++) celdas.push(dia);
		while (celdas.length % 7 !== 0) celdas.push(null);

		return celdas;
	}

	function eventosDelDiaCliente(anio, mes, dia) {
		if (!dia) return [];
		return eventosSerializados.filter((e) => e.y === anio && e.m === mes && e.d === dia);
	}

	function crearCeldaHTML(dia, anio, mes) {
		if (!dia) return `<div class="celda-dia vacio"></div>`;

		const esHoy = anio === anioInicial && mes === mesInicial && dia === diaHoyInicial;
		const eventosDia = eventosDelDiaCliente(anio, mes, dia);

		const clases = ["celda-dia"];
		if (eventosDia.length > 0) clases.push("con-evento");
		if (esHoy) clases.push("es-hoy");

		if (eventosDia.length === 0) {
			return `<div class="${clases.join(" ")}"><span class="numero-dia">${dia}</span></div>`;
		}

		const tooltip = eventosDia.map((e) => `${e.hora} - ${e.title}`).join("\n");
		const chips = eventosDia
			.slice(0, 2)
			.map(
				(e) =>
					`<div class="chip-evento" style="background-color:${e.color}22; color:${e.color}">
						<span class="chip-punto" style="background-color:${e.color}"></span><span class="chip-texto">${e.hora} · ${e.title}</span>
					</div>`
			)
			.join("");
		const masTexto =
			eventosDia.length > 2 ? `<span class="mas-mini">+${eventosDia.length - 2} más</span>` : "";

		return `<div class="${clases.join(" ")}" title="${tooltip}">
			<span class="numero-dia">${dia}</span>
			<div class="chips-dia">${chips}${masTexto}</div>
		</div>`;
	}

	function renderMes(nuevoOffset) {
		offsetMeses = nuevoOffset;

		const fechaBase = new Date(anioInicial, mesInicial + offsetMeses, 1);
		const anio = fechaBase.getFullYear();
		const mes = fechaBase.getMonth();

		tituloMes.textContent = `${nombresMes[mes]} ${anio}`;
		contenedorGrid.innerHTML = obtenerCeldasMes(anio, mes)
			.map((dia) => crearCeldaHTML(dia, anio, mes))
			.join("");

		btnAnterior.disabled = offsetMeses <= 0;
	}

	if (contenedorGrid && tituloMes && btnAnterior && btnSiguiente) {
		btnAnterior.addEventListener("click", () => renderMes(offsetMeses - 1));
		btnSiguiente.addEventListener("click", () => renderMes(offsetMeses + 1));
		renderMes(0);
	}
</script>
