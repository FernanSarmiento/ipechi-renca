---
// Sección "EN VIVO": se mantiene oculta y solo aparece cuando YouTube informa
// que el canal está transmitiendo
---

<section id="en-vivo" hidden>
	<div class="ev-card">
		<div class="ev-header">
			<span class="ev-badge"><i class="ev-dot"></i> EN VIVO</span>
			<span class="ev-sub">Estamos transmitiendo ahora</span>
		</div>

		<h2 id="ev-titulo">Transmisión en vivo</h2>

		<div class="ev-video">
			<iframe
				id="ev-iframe"
				title="Transmisión en vivo de Ipechi Renca"
				allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
				allowfullscreen
				referrerpolicy="strict-origin-when-cross-origin"
			></iframe>
		</div>

		<a id="ev-link" class="ev-btn" href="https://www.youtube.com/@ipechirenca/live" target="_blank" rel="noopener">
			Ver en YouTube
		</a>
	</div>
</section>

<style>
	#en-vivo {
		padding: 70px 20px 30px;
		background: transparent;
	}
	#en-vivo[hidden] { display: none; }

	.ev-card {
		max-width: 900px;
		margin: 0 auto;
		text-align: center;
		background-color: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(239, 68, 68, 0.45);
		border-radius: 24px;
		padding: 30px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 40px rgba(239, 68, 68, 0.18);
		animation: ev-entrada 0.6s ease both;
	}

	.ev-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 14px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}

	.ev-badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		background: #ef4444;
		color: #fff;
		font-weight: 800;
		letter-spacing: 3px;
		font-size: 0.95rem;
		padding: 8px 18px;
		border-radius: 50px;
		box-shadow: 0 0 22px rgba(239, 68, 68, 0.55);
	}

	.ev-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #fff;
		animation: ev-pulso 1.3s ease-in-out infinite;
	}

	.ev-sub {
		color: #22d3ee;
		font-weight: 600;
		letter-spacing: 1px;
		text-transform: uppercase;
		font-size: 0.85rem;
	}

	#ev-titulo {
		font-size: 1.8rem;
		color: #fff;
		margin: 0 0 22px 0;
		font-weight: 800;
		text-transform: none;
		line-height: 1.2;
	}

	.ev-video {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		border-radius: 14px;
		overflow: hidden;
		border: 2px solid rgba(255, 255, 255, 0.1);
		background: #000;
	}
	.ev-video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.ev-btn {
		display: inline-block;
		margin-top: 24px;
		color: #ef4444;
		border: 2px solid #ef4444;
		padding: 12px 30px;
		border-radius: 50px;
		text-decoration: none;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
		font-size: 0.95rem;
		transition: all 0.3s ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.ev-btn:hover {
			background-color: #ef4444;
			color: #fff;
			box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
			transform: scale(1.04);
		}
	}
	.ev-btn:active { background-color: #ef4444; color: #fff; transform: scale(0.97); }

	@keyframes ev-pulso {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.35; transform: scale(0.7); }
	}
	@keyframes ev-entrada {
		from { opacity: 0; transform: translateY(20px); }
		to { opacity: 1; transform: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.ev-dot, .ev-card { animation: none; }
	}
	@media (max-width: 768px) {
		#en-vivo { padding: 50px 10px 20px; }
		.ev-card { padding: 20px 15px; }
		#ev-titulo { font-size: 1.3rem; }
	}
</style>

<script>
	const seccion = document.getElementById("en-vivo");
	const iframe = document.getElementById("ev-iframe") as HTMLIFrameElement | null;
	const titulo = document.getElementById("ev-titulo");
	const enlace = document.getElementById("ev-link") as HTMLAnchorElement | null;
	const pildora = document.getElementById("hero-en-vivo");

	const INTERVALO_MS = 2 * 60 * 1000; // revisa cada 2 minutos mientras la página está abierta
	let videoActual: string | null = null;

	function mostrar(id: string, texto: string) {
		if (!seccion || !iframe) return;
		if (videoActual !== id) {
			// Solo se vuelve a cargar el reproductor si cambió la transmisión,
			// para no cortar el video de quien ya lo está viendo.
			iframe.src = `https://www.youtube.com/embed/${id}?rel=0`;
			videoActual = id;
		}
		if (titulo) titulo.textContent = texto || "Transmisión en vivo";
		if (enlace) enlace.href = `https://www.youtube.com/watch?v=${id}`;
		seccion.hidden = false;
		if (pildora) pildora.hidden = false;
	}

	function ocultar() {
		if (!seccion || !iframe) return;
		seccion.hidden = true;
		if (pildora) pildora.hidden = true;
		if (videoActual) {
			iframe.src = "about:blank"; // detiene el video cuando termina la transmisión
			videoActual = null;
		}
	}

	async function revisar() {
		// Modo prueba: /?demo-en-vivo muestra la sección con un video de ejemplo
		if (new URLSearchParams(location.search).has("demo-en-vivo")) {
			mostrar("xHLIQtIk9es", "Culto General (vista de prueba)");
			return;
		}
		try {
			const res = await fetch("/.netlify/functions/en-vivo", { cache: "no-store" });
			if (!res.ok) return;
			const datos = await res.json();
			if (datos.live && datos.id) mostrar(datos.id, datos.title);
			else ocultar();
		} catch {
			/* sin conexión o sin función disponible (por ejemplo en local): no se muestra nada */
		}
	}

	revisar();
	setInterval(() => {
		if (document.visibilityState === "visible") revisar();
	}, INTERVALO_MS);
</script>
