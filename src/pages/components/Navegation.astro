<nav class="nav-links">
    <div class="nav-mobile-bar">
        <span class="nav-logo-text">Ipechi Renca</span>
        <button type="button" class="menu-toggle" id="menu-toggle" aria-label="Abrir menú" aria-expanded="false">
            <span class="menu-icon"></span>
        </button>
    </div>

    <div class="links" id="nav-links">
        <a href="/">Inicio</a>
        <a href="#horarios">Horarios</a>
        <a href="#ubicacion">Ubicación</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#noticias">Redes</a>
        <a href="#galeria">Galería</a>
        <a href="#calendario">Calendario</a>
        <a href="#contacto">Contacto</a>
    </div>
</nav>

<style>
    nav {
        background-color: transparent; 
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100; /* Lo subimos para que siempre esté por encima de todo */
        padding: 30px 5%; 
        box-sizing: border-box; 
        display: flex;
        justify-content: center; 
        align-items: center;
    }

    .nav-mobile-bar {
        display: none;
    }

    /* PÍLDORA DE CRISTAL (Glassmorphism) */
    .links {
        display: flex;
        gap: 30px; 
        flex-wrap: wrap; 
        justify-content: center;
        background: rgba(30, 41, 59, 0.4); /* Fondo oscuro transparente */
        backdrop-filter: blur(12px); /* Efecto desenfoque */
        padding: 12px 35px;
        border-radius: 50px; /* Bordes totalmente redondos */
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .links a {
        text-decoration: none;
        color: #e2e8f0; /* Blanco apagado */
        font-weight: 600;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        position: relative; /* Necesario para la línea animada */
    }

    /* LÍNEA ANIMADA NEÓN (Debajo del texto) */
    .links a::after {
        content: '';
        position: absolute;
        width: 0;
        height: 2px;
        bottom: -5px;
        left: 0;
        background-color: #22d3ee; /* Cyan Neón */
        transition: width 0.3s ease;
        box-shadow: 0 0 8px rgba(34, 211, 238, 0.6);
    }

    /* HOVER: Al pasar el mouse */
    .links a:hover {
        color: #22d3ee;
        text-shadow: 0 0 8px rgba(34, 211, 238, 0.4);
    }

    /* La línea crece al 100% al hacer hover */
    .links a:hover::after {
        width: 100%;
    }

    /* RESPONSIVE: MENÚ HAMBURGUESA EN CELULAR */
    @media (max-width: 768px) {
        nav {
            padding: 15px 20px;
            flex-direction: column;
            align-items: stretch;
            position: relative; /* En celular, que empuje el contenido hacia abajo */
            background-color: #0b1120; /* Fondo azul extra oscuro */
            border-bottom: 1px solid rgba(34, 211, 238, 0.2); /* Borde cyan sutil */
        }

        .nav-mobile-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .nav-logo-text {
            color: #ffffff;
            font-weight: 800;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .menu-toggle {
            width: 40px;
            height: 40px;
            border-radius: 8px;
            border: 2px solid #22d3ee;
            background-color: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .menu-icon,
        .menu-icon::before,
        .menu-icon::after {
            display: block;
            width: 18px;
            height: 2px;
            border-radius: 2px;
            background-color: #22d3ee;
            transition: all 0.3s ease;
        }

        .menu-icon {
            position: relative;
        }

        .menu-icon::before,
        .menu-icon::after {
            content: '';
            position: absolute;
            left: 0;
        }

        .menu-icon::before {
            top: -6px;
        }

        .menu-icon::after {
            top: 6px;
        }

        /* Transforma la hamburguesa en una X cuando el menú está abierto */
        .menu-toggle.abierto .menu-icon {
            background-color: transparent;
        }

        .menu-toggle.abierto .menu-icon::before {
            top: 0;
            transform: rotate(45deg);
        }

        .menu-toggle.abierto .menu-icon::after {
            top: 0;
            transform: rotate(-45deg);
        }

        .links {
            flex-direction: column;
            align-items: stretch;
            gap: 0;
            max-height: 0;
            overflow: hidden;
            padding: 0;
            margin-top: 0;
            background: transparent;
            backdrop-filter: none;
            border: none;
            box-shadow: none;
            transition: max-height 0.35s ease, margin-top 0.35s ease;
        }

        .links.abierto {
            max-height: 500px;
            margin-top: 15px;
        }

        .links a {
            padding: 14px 5px;
            font-size: 0.9rem;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .links a:last-child {
            border-bottom: none;
        }
    }
</style>

<script>
    const boton = document.getElementById("menu-toggle");
    const menu = document.getElementById("nav-links");

    if (boton && menu) {
        boton.addEventListener("click", () => {
            const abierto = menu.classList.toggle("abierto");
            boton.classList.toggle("abierto", abierto);
            boton.setAttribute("aria-expanded", String(abierto));
        });

        // Cierra el menú al hacer clic en cualquier link (navegación por ancla)
        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                menu.classList.remove("abierto");
                boton.classList.remove("abierto");
                boton.setAttribute("aria-expanded", "false");
            });
        });
    }
</script>