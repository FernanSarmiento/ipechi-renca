---
// --- Configuración del carrusel de YouTube ---
const CHANNEL_ID = "UCaYwKGwfWfOMbIbzUOMgY7Q";
// El "playlist de subidas" de cualquier canal es el mismo ID cambiando UC por UU
const UPLOADS_PLAYLIST_ID = "UU" + CHANNEL_ID.slice(2);
const YOUTUBE_API_KEY = import.meta.env.YOUTUBE_API_KEY;
console.log("DEBUG - YOUTUBE_API_KEY presente:", Boolean(YOUTUBE_API_KEY));

let videos = [];

if (YOUTUBE_API_KEY) {
	try {
		const res = await fetch(
			`https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&playlistId=${UPLOADS_PLAYLIST_ID}&maxResults=10&key=${YOUTUBE_API_KEY}`
		);
		const data = await res.json();

		if (data.items) {
			videos = data.items
				.filter((item) => item.snippet?.resourceId?.videoId)
				.map((item) => ({
					id: item.snippet.resourceId.videoId,
					title: item.snippet.title,
					thumbnail: item.snippet.thumbnails?.medium?.url ?? item.snippet.thumbnails?.default?.url,
				}));
		}
	} catch (error) {
		console.error("No se pudieron cargar los videos de YouTube:", error);
	}
}

// Si falla la API o no hay key configurada, mostramos al menos un video fijo
if (videos.length === 0) {
	videos = [
		{
			id: "xHLIQtIk9es",
			title: "Último mensaje",
			thumbnail: "https://i.ytimg.com/vi/xHLIQtIk9es/mqdefault.jpg",
		},
	];
}
---

<section id="noticias">
	<div class="header-noticias">
		<span class="etiqueta">Conéctate</span>
		<h2>Nuestras Redes</h2>
	</div>

	<div class="media-grid">

		<div class="card-social facebook-feed">
			<div class="titulo-red">
				<span class="icono-fb">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
				</span>
				<h3>Últimas Noticias</h3>
			</div>

			<div class="iframe-container">
				<iframe
					src="https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2FIpechiRencaOficial&tabs=timeline&width=340&height=300&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId"
					width="100%"
					height="300"
					style="border:none;overflow:hidden"
					scrolling="no"
					frameborder="0"
					loading="lazy"
					allowfullscreen="true"
					allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
				</iframe>
			</div>
			<p class="nota-pie">Síguenos en Facebook para ver fotos y eventos en tiempo real.</p>
		</div>

		<div class="card-social youtube-feed">
			<div class="titulo-red">
				<span class="icono-yt">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
				</span>
				<h3>Videos Recientes</h3>
			</div>

			<div class="carrusel-container" id="carrusel-container">
				<button type="button" class="flecha-carrusel flecha-izq" id="flecha-izq" aria-label="Video anterior">‹</button>
				<div class="carrusel-track" id="carrusel-track">
					{videos.map((video) => (
						<a
							href={`https://www.youtube.com/watch?v=${video.id}`}
							target="_blank"
							class="carrusel-item"
						>
							<img src={video.thumbnail} alt={video.title} loading="lazy" draggable="false" />
							<p>{video.title}</p>
						</a>
					))}
					{videos.map((video) => (
						<a
							href={`https://www.youtube.com/watch?v=${video.id}`}
							target="_blank"
							class="carrusel-item"
							aria-hidden="true"
							tabindex="-1"
						>
							<img src={video.thumbnail} alt="" loading="lazy" draggable="false" />
							<p>{video.title}</p>
						</a>
					))}
				</div>
				<button type="button" class="flecha-carrusel flecha-der" id="flecha-der" aria-label="Video siguiente">›</button>
			</div>

			<div class="btn-container">
				<a href="https://www.youtube.com/@ipechirenca/featured" target="_blank" class="btn-youtube">
					Ver canal completo
				</a>
			</div>
		</div>

	</div>
</section>

<style>
	#noticias {
		padding: 100px 20px;
		background-color: transparent;
		text-align: center;
	}

	.header-noticias {
		margin-bottom: 60px;
	}

	.etiqueta {
		color: #22d3ee;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 2px;
		font-size: 0.85rem;
		display: block;
		margin-bottom: 10px;
		text-shadow: 0 0 10px rgba(34, 211, 238, 0.3);
	}

	h2 {
		font-size: 3rem;
		color: #ffffff;
		margin: 0;
		font-weight: 800;
		text-transform: uppercase;
	}

	.media-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: flex-start;
		gap: 40px;
		max-width: 1200px;
		margin: 0 auto;
	}

	.card-social {
		flex: 1;
		min-width: 320px;
		max-width: 500px;
		background-color: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.05);
		border-radius: 24px;
		padding: 30px;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		transition: transform 0.4s ease, border-color 0.4s ease;
		display: flex;
		flex-direction: column;
	}

	.card-social:hover {
		transform: translateY(-5px);
		border-color: rgba(34, 211, 238, 0.3);
		box-shadow: 0 20px 40px rgba(34, 211, 238, 0.1);
	}

	.titulo-red {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 15px;
		margin-bottom: 25px;
	}

	.titulo-red h3 {
		color: #ffffff;
		font-size: 1.6rem;
		margin: 0;
		font-weight: 700;
	}

	.icono-fb { color: #3b82f6; filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6)); }
	.icono-yt { color: #ef4444; filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.6)); }

	.iframe-container {
		background: #ffffff;
		border-radius: 12px;
		overflow: hidden;
		display: flex;
		justify-content: center;
		border: 2px solid rgba(255,255,255,0.1);
		flex-shrink: 0;
	}

	.iframe-container iframe {
		height: 300px;
	}

	.nota-pie {
		color: #94a3b8;
		font-size: 0.95rem;
		margin-top: 20px;
	}

	/* CARRUSEL DE VIDEOS */
	.carrusel-container {
		position: relative;
		overflow: hidden;
		border-radius: 12px;
		margin-bottom: 30px;
		cursor: grab;
		user-select: none;
		border: 2px solid rgba(255,255,255,0.1);
		background: transparent;
	}

	.carrusel-container:active {
		cursor: grabbing;
	}

	.flecha-carrusel {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 5;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 2px solid #22d3ee;
		background-color: rgba(5, 5, 5, 0.6);
		backdrop-filter: blur(4px);
		color: #22d3ee;
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.flecha-carrusel:hover {
		background-color: #22d3ee;
		color: #0f172a;
		box-shadow: 0 0 15px rgba(34, 211, 238, 0.5);
	}

	.flecha-izq {
		left: 8px;
	}

	.flecha-der {
		right: 8px;
	}

	.carrusel-track {
		display: flex;
		gap: 14px;
		padding: 14px;
		width: max-content;
		will-change: transform;
	}

	.carrusel-item {
		flex: 0 0 auto;
		width: 250px;
		text-decoration: none;
		color: #e2e8f0;
		display: block;
	}

	.carrusel-item img {
		width: 100%;
		height: 190px;
		object-fit: cover;
		border-radius: 8px;
		display: block;
		border: 1px solid rgba(255,255,255,0.08);
		transition: border-color 0.3s ease, filter 0.3s ease;
	}

	.carrusel-item:hover img {
		border-color: #22d3ee;
		filter: brightness(1.1);
	}

	.carrusel-item p {
		margin: 8px 0 0 0;
		font-size: 0.78rem;
		line-height: 1.3;
		color: #cbd5e1;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.btn-container {
		margin-top: auto;
	}

	.btn-youtube {
		display: inline-block;
		background-color: transparent;
		color: #ef4444;
		padding: 12px 30px;
		border: 2px solid #ef4444;
		border-radius: 50px;
		text-decoration: none;
		font-weight: bold;
		text-transform: uppercase;
		letter-spacing: 1px;
		transition: all 0.3s ease;
		width: 100%;
		box-sizing: border-box;
	}

	.btn-youtube:hover {
		background-color: #ef4444;
		color: #ffffff;
		box-shadow: 0 0 20px rgba(239, 68, 68, 0.5);
		transform: scale(1.02);
	}

	iframe { max-width: 100%; }

	@media (max-width: 768px) {
		#noticias { padding: 60px 10px; }
		.card-social { padding: 20px 15px; }
		h2 { font-size: 2.2rem; }
		.carrusel-item { width: 190px; }
		.carrusel-item img { height: 145px; }
	}
</style>

<script>
	const container = document.getElementById("carrusel-container");
	const track = document.getElementById("carrusel-track");
	const flechaIzq = document.getElementById("flecha-izq");
	const flechaDer = document.getElementById("flecha-der");

	if (container && track) {
		let offset = 0;
		let isPaused = false;
		let isDragging = false;
		let dragMoved = false;
		let startX = 0;
		let startOffset = 0;
		const SPEED = 0.5; // píxeles por frame

		function animate() {
			if (!isPaused && !isDragging) {
				offset -= SPEED;
				const halfWidth = track.scrollWidth / 2;
				if (Math.abs(offset) >= halfWidth) offset = 0;
				track.style.transform = `translateX(${offset}px)`;
			}
			requestAnimationFrame(animate);
		}

		function startDrag(clientX) {
			isDragging = true;
			dragMoved = false;
			startX = clientX;
			startOffset = offset;
		}

		function moveDrag(clientX) {
			if (!isDragging) return;
			const delta = clientX - startX;
			if (Math.abs(delta) > 5) dragMoved = true;
			offset = startOffset + delta;
			track.style.transform = `translateX(${offset}px)`;
		}

		function endDrag() {
			if (!isDragging) return;
			isDragging = false;

			normalizarOffset();

			if (dragMoved) {
				track.addEventListener(
					"click",
					(e) => e.preventDefault(),
					{ capture: true, once: true }
				);
			}
		}

		function normalizarOffset() {
			const halfWidth = track.scrollWidth / 2;
			while (offset > 0) offset -= halfWidth;
			while (offset <= -halfWidth) offset += halfWidth;
		}

		function moverConFlecha(direccion) {
			if (!track.children.length) return;
			const anchoItem = track.children[0].getBoundingClientRect().width;
			const gap = parseFloat(getComputedStyle(track).gap) || 14;
			const paso = anchoItem + gap;

			offset += direccion === "izquierda" ? paso : -paso;
			normalizarOffset();
			track.style.transform = `translateX(${offset}px)`;
		}

		container.addEventListener("mouseenter", () => (isPaused = true));
		container.addEventListener("mouseleave", () => {
			isPaused = false;
			endDrag();
		});

		container.addEventListener("mousedown", (e) => startDrag(e.clientX));
		window.addEventListener("mousemove", (e) => moveDrag(e.clientX));
		window.addEventListener("mouseup", endDrag);

		container.addEventListener("touchstart", (e) => startDrag(e.touches[0].clientX));
		container.addEventListener("touchmove", (e) => moveDrag(e.touches[0].clientX));
		container.addEventListener("touchend", endDrag);

		if (flechaIzq && flechaDer) {
			// Evita que el clic en la flecha también dispare el inicio del arrastre del carrusel
			flechaIzq.addEventListener("mousedown", (e) => e.stopPropagation());
			flechaDer.addEventListener("mousedown", (e) => e.stopPropagation());
			flechaIzq.addEventListener("touchstart", (e) => e.stopPropagation());
			flechaDer.addEventListener("touchstart", (e) => e.stopPropagation());

			flechaIzq.addEventListener("click", () => moverConFlecha("izquierda"));
			flechaDer.addEventListener("click", () => moverConFlecha("derecha"));
		}

		requestAnimationFrame(animate);
	}
</script>
